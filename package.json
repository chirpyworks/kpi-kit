{
  "name": "kpi-kit",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "Open-source React KPI patterns, chart primitives, tables, filters and data states.",
  "type": "module",
  "license": "MIT",
  "author": "CHIRPYWORKS",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:kit": "vite --host 127.0.0.1 --open /kit.html",
    "build": "tsc --noEmit && vite build && node scripts/stamp-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:kit": "tsc -p tsconfig.kit.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:kit": "npm run build && python tests/kit_browser.py",
    "check:repository": "node scripts/check-repository.mjs",
    "verify": "npm run check:repository && npm run typecheck && npm test && npm run build",
    "verify:release": "node scripts/verify-release.mjs",
    "build:standalone": "npm run build && node scripts/create-preview.mjs"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "5.8.3",
    "vite": "8.3.1"
  }
}
